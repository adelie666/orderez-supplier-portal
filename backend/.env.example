# ============================================================
# OrderEZ Supplier Portal · 环境变量模板
# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 排除。
# ============================================================

# 服务
PORT=3100
NODE_ENV=development

# 数据库（Postgres）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orderez_supplier?schema=public

# JWT
# 生产环境必须替换为随机值：openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# 上游 ERP 凭证加密密钥（AES-256-GCM）
# 生产环境必须设置：openssl rand -hex 32
# 本地留空会从 JWT_SECRET 派生，仅限开发使用。
CREDENTIALS_KEY=

# 上游 ERP 接入地址与商品图片域名（可选）
# 留空则用占位默认值；接入地址也可以启动后在页面「Integrazione」里填写并存进数据库。
ERP_BASE_URL=
ERP_IMAGE_BASE_URL=

# 定时拉单（分钟）
SYNC_INTERVAL_MINUTES=1
SYNC_ENABLED=true
# 拉单回看天数（水位为空时的起点）
SYNC_LOOKBACK_DAYS=30

# Redis（可选；留空则用进程内重试，不阻塞本地开发）
REDIS_URL=

# 前端跨域白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5273

# 初始管理员
# 后端启动时若发现库里一个用户都没有，会自动创建这个账号并打印密码；
# 留空则随机生成（只打印一次）。`pnpm seed` 也用这两个值。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=OrderEZ@2026

# 演示供应商账号密码（仅 npm run seed:demo 使用）
SEED_DEMO_SUPPLIER_PASSWORD=Fornitore@2026
