# ============================================================
# OrderEZ Supplier Portal · 部署环境变量
#
#   cd deploy
#   cp .env.example .env
#   # 填好下面标了「必填」的三项，再 docker compose up -d --build
#
# .env 已被 .gitignore 排除，不要提交。
# ============================================================

# 对外端口（前端 Nginx）。域名/HTTPS 建议在前面再放一层反代。
HTTP_PORT=8080

# ---------- 数据库 ----------
POSTGRES_DB=orderez_supplier
POSTGRES_USER=orderez
# 必填。建议只用字母数字，避免密码里的 @ : / 破坏 DATABASE_URL。
# 生成：openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# ---------- 密钥 ----------
# 必填。签 JWT 用；换掉之后所有已登录会话立即失效。
# 生成：openssl rand -hex 32
JWT_SECRET=

# 必填。加密库里的 ERP 凭证（AES-256-GCM）。
# 一旦写入过凭证就不要再改，改了旧密文解不开，需要在页面上重新填一次。
# 生成：openssl rand -hex 32
CREDENTIALS_KEY=

# 登录令牌有效期
JWT_EXPIRES_IN=12h

# ---------- 上游 ERP ----------
# 接入地址与商品图片域名。留空则用占位默认值；
# 接入地址也可以部署后在页面「Integrazione」里填写（会存进数据库）。
ERP_BASE_URL=
ERP_IMAGE_BASE_URL=

# ---------- 定时同步 ----------
SYNC_ENABLED=true
# 拉单间隔（分钟）
SYNC_INTERVAL_MINUTES=5
# 水位为空时往前回看多少天
SYNC_LOOKBACK_DAYS=30

# ---------- 跨域 ----------
# 前端与接口同源（Nginx 反代 /api）时其实用不到；
# 如果前端单独部署在别的域名，这里必须写上那个域名，逗号分隔。
CORS_ORIGINS=http://localhost:8080

# ---------- 初始管理员 ----------
# 后端启动时如果发现库里一个用户都没有，会自动创建下面这个管理员账号。
# 密码留空 = 随机生成，并打印在容器日志里（只打印这一次，日志滚过去就没了）：
#   docker compose logs backend | grep -A6 "Nessun account"
# 想自己定密码就填在这里。首次登录后请立即在页面上修改。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
